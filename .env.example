# Copie para .env.local (dev) e cadastre as mesmas variáveis na Vercel (Settings > Environment Variables).

# Google Tag Manager — configure GA4, Meta Pixel e conversões do Google Ads dentro do GTM.
# Só é carregado depois que o visitante aceita os cookies (LGPD).
VITE_GTM_ID=

# Webhook que recebe os leads do diagnóstico (Make, Zapier, n8n, Supabase Edge Function, CRM).
# Corpo enviado: JSON com Content-Type text/plain.
VITE_LEAD_WEBHOOK_URL=
